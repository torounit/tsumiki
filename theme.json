{
	"$schema": "https://schemas.wp.org/wp/7.2/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"radiusSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.5rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.5rem"
				},
				{
					"name": "Full",
					"slug": "full",
					"size": "9999px"
				}
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#1d1816",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#ffd6a7",
					"name": "Accent 1",
					"slug": "accent-1"
				},
				{
					"color": "#473c39",
					"name": "Accent 4",
					"slug": "accent-4"
				},
				{
					"color": "#f3f1f1",
					"name": "Accent 5",
					"slug": "accent-5"
				},
				{
					"color": "#e8e4e3",
					"name": "Accent 6",
					"slug": "accent-6"
				}
			]
		},
		"layout": {
			"contentSize": "51rem",
			"wideSize": "86rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "1.5rem",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "2.5rem",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "4rem",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "6.5rem",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "10.5rem",
					"slug": "80"
				}
			],
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"fontFamily": "sans-serif",
					"name": "Sans-serif",
					"slug": "sans-serif"
				},
				{
					"fontFamily": "monospace",
					"name": "Monospace",
					"slug": "monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.8rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.142857rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "1.6rem",
					"slug": "x-large"
				},
				{
					"name": "Extra Extra Large",
					"size": "2.666667rem",
					"slug": "xx-large"
				},
				{
					"name": "Extra Extra Extra Large",
					"size": "4rem",
					"slug": "xxx-large"
				}
			]
		},
		"viewport": {
			"mobile": "600px",
			"tablet": "782px"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans-serif",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.75"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var:preset|border-radius|full"
				},
				"color": {
					"background": "var:preset|color|accent-4",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|20",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|20"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "500",
					"lineHeight": "1.75"
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.75"
				}
			},
			"cite": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "italic"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontWeight": "400",
					"lineHeight": "1.4"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.5"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.6"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700",
					"lineHeight": "1.75"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.75"
				}
			},
			"label": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"textInput": {
				"border": {
					"color": "var:preset|color|accent-6",
					"radius": "var:preset|border-radius|small",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|20",
						"left": "var:preset|spacing|30",
						"right": "var:preset|spacing|30",
						"top": "var:preset|spacing|20"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				},
				"::placeholder": {
					"color": {
						"text": "var:preset|color|accent-4"
					}
				}
			}
		},
		"blocks": {
			"core/accordion-item": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				}
			},
			"core/avatar": {
				"border": {
					"radius": "var:preset|border-radius|full"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"style": "solid",
							"width": "1px"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|accent-4"
						},
						"spacing": {
							"padding": {
								"bottom": "calc(var(--wp--preset--spacing--20) - 1px)",
								"left": "calc(var(--wp--preset--spacing--40) - 1px)",
								"right": "calc(var(--wp--preset--spacing--40) - 1px)",
								"top": "calc(var(--wp--preset--spacing--20) - 1px)"
							}
						}
					}
				}
			},
			"core/code": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				},
				"color": {
					"background": "var:preset|color|accent-5"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|monospace",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/cover": {
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				},
				"border": {
					"radius": "var:preset|border-radius|medium"
				}
			},
			"core/details": {
				"border": {
					"color": "var:preset|color|accent-6",
					"radius": "var:preset|border-radius|medium",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				}
			},
			"core/media-text": {
				"css": "& .wp-block-media-text__media img{border-radius:var(--wp--preset--border-radius--medium)}& .wp-block-media-text__media video{border-radius:var(--wp--preset--border-radius--medium)}"
			},
			"core/navigation-overlay-close": {
				"border": {
					"radius": "var:preset|border-radius|full"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|monospace",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				}
			},
			"core/preformatted": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				},
				"color": {
					"background": "var:preset|color|accent-5"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|monospace",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/pullquote": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				},
				"color": {
					"background": "var:preset|color|accent-1"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.75"
				},
				"elements": {
					"cite": {
						"color": {
							"text": "var:preset|color|contrast"
						}
					}
				}
			},
			"core/query-pagination-numbers": {
				"css": "& .page-numbers{border-radius:var(--wp--preset--border-radius--full)}"
			},
			"core/quote": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				},
				"color": {
					"background": "var:preset|color|accent-5"
				},
				"spacing": {
					"blockGap": "var:preset|spacing|20",
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				}
			},
			"core/separator": {
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"color": {
					"text": "var:preset|color|accent-6"
				}
			},
			"core/site-logo": {
				"css": "& img{border-radius:var(--wp--preset--border-radius--small)}"
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/tab-list": {
				"border": {
					"radius": "var:preset|border-radius|full"
				}
			},
			"core/video": {
				"css": "& video{border-radius:var(--wp--preset--border-radius--medium)}"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
