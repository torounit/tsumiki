{
	"$schema": "https://schemas.wp.org/wp/7.2/theme.json",
	"version": 3,
	"title": "Site Main",
	"slug": "site-main",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"spacing": {
			"padding": {
				"bottom": "var:preset|spacing|70",
				"top": "var:preset|spacing|60"
			}
		},
		"@tablet": {
			"spacing": {
				"padding": {
					"bottom": "var:preset|spacing|60",
					"top": "var:preset|spacing|40"
				}
			}
		},
		"@mobile": {
			"spacing": {
				"padding": {
					"bottom": "var:preset|spacing|60",
					"top": "var:preset|spacing|40"
				}
			}
		}
	}
}
