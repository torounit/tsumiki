{
	"$schema": "https://schemas.wp.org/wp/7.2/theme.json",
	"version": 3,
	"title": "Site Footer",
	"slug": "site-footer",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"border": {
			"radius": {
				"topLeft": "var:preset|border-radius|medium",
				"topRight": "var:preset|border-radius|medium"
			}
		},
		"color": {
			"background": "var:preset|color|accent-5"
		},
		"spacing": {
			"padding": {
				"bottom": "var:preset|spacing|60",
				"top": "var:preset|spacing|60"
			}
		},
		"@tablet": {
			"spacing": {
				"padding": {
					"bottom": "var:preset|spacing|40",
					"top": "var:preset|spacing|40"
				}
			}
		},
		"@mobile": {
			"spacing": {
				"padding": {
					"bottom": "var:preset|spacing|40",
					"top": "var:preset|spacing|40"
				}
			}
		}
	}
}
