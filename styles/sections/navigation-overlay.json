{
	"$schema": "https://schemas.wp.org/wp/7.2/theme.json",
	"version": 3,
	"title": "Navigation Overlay",
	"slug": "navigation-overlay",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"dimensions": {
			"minHeight": "100dvh"
		},
		"spacing": {
			"blockGap": "0"
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.4"
				},
				"@tablet": {
					"typography": {
						"fontSize": "var:preset|font-size|x-large"
					}
				},
				"@mobile": {
					"typography": {
						"fontSize": "var:preset|font-size|x-large"
					}
				}
			}
		}
	}
}
