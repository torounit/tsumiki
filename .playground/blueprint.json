{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"login": true,
	"preferredVersions": {
		"php": "8.3",
		"wp": "beta"
	},
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Tsumiki"
			}
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": true,
				"SCRIPT_DEBUG": true,
				"WP_DEVELOPMENT_MODE": "theme",
				"WP_ENVIRONMENT_TYPE": "local"
			}
		},
		{
			"step": "activateTheme",
			"themeFolderName": "tsumiki"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "theme-check"
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WPTT/theme-unit-test/master/themeunittestdata.wordpress.xml"
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/theme-test-data/master/64-block-test-data.xml"
			}
		}
	]
}
